{
  "name": "Swarm core",
  "description": "The swarm CLI itself: worker loop, boards, runners, ledger.",
  "paths": [
    "src/**",
    "bin/**",
    "test/**",
    "docs/**"
  ],
  "protect": [
    "LICENSE",
    "package.json"
  ],
  "verify": [
    {
      "name": "unit-tests",
      "run": "node --test test/*.test.mjs",
      "timeoutSec": 300
    }
  ],
  "limits": {
    "maxFilesChanged": 20,
    "maxDiffLines": 1000
  },
  "review": {
    "quorum": 1
  },
  "replication": 1,
  "claimTtlMinutes": 90
}
